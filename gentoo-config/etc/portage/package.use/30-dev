############ TOOLCHAIN ############
# gcc: removidos cobol, rust (front-ends extras que só alongam o build) e 'vanilla'
# (contradiz hardened/pie/ssp: desliga os defaults que você pediu). 'jit' fica: o Emacs native-comp usa.
sys-devel/gcc cxx pie ssp hardened -lto -pgo pch openmp extra -libgdiagnostics zstd -valgrind fortran -ada -d -modula2 -go -objc -fixed-point -objc-gc -debug cet -systemtap -ieee-long-double -test jit multilib -default-stack-clash-protection time64

llvm-core/clang extra pie static-analyzer verify-sig xml -doc -test -debug -ieee-long-double
llvm-core/llvm LLVM_TARGETS: -* X86 RISCV
llvm-core/clang LLVM_TARGETS: -* X86 RISCV
dev-debug/gdb multitarget

# Rust: use SÓ o rust-bin (emerge -1 dev-lang/rust-bin). O dev-lang/rust do fonte com
# ABI_X86=32 64 compilava o compilador duas vezes.
dev-lang/rust-bin clippy rustfmt rust-analyzer rust-src

