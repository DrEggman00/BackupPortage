############ BOOT / KERNEL ############
# Um kernel só: gentoo-kernel (dist-kernel). O nvidia-drivers usa dist-kernel, então
# misturar com cachyos-sources exigiria `-dist-kernel` e @module-rebuild manual.
sys-kernel/gentoo-kernel -debug -experimental -hardened modules-compress -modules-sign -secureboot savedconfig -test -verify-sig initramfs strip
sys-kernel/installkernel dracut grub
sys-boot/grub mount

############ SYSTEMD ############
# Removidos: bpf (exige clang com LLVM_TARGETS BPF), secureboot, -split-usr, -cgroup-hybrid,
# -vanilla (flags removidas/inúteis). sysv-utils estava ligado E desligado; ficou ligado.
sys-apps/systemd kernel-install kmod lz4 zstd seccomp acl pam policykit xkb cryptsetup elfutils resolvconf dns-over-tls openssl tpm sysv-utils -http -curl -importd -homed -passwdqc -pwquality -pkcs11 -audit -apparmor -selinux -test -lzma -idn -iptables

