# Flags Compiller
#COMMON_FLAGS="-march=native -O2 -pipe -fomit-frame-pointer -fstack-protector-strong -flto=auto"
COMMON_FLAGS="-march=native -O3 -pipe -flto"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
#LDFLAGS="-Wl,-O1 -Wl,--as-needed -flto=auto"
#LDFLAGS="-Wl,-O1 -Wl,--as-needed -fuse-ld=lld"
LDFLAGS="-Wl,-O1 -Wl,--as-needed -Wl,-z,relro -Wl,-z,now -flto=auto"
#RUSTFLAGS="-C target-cpu=native -C opt-level=3"
RUSTFLAGS="-C target-cpu=native"

#egl gbm sound-server handbook acpi pgo"
#USE="X -Xaw3d -a52 aac acpi alsa asm bluetooth bzip2 -calendar -cdr cjk cuda -cups curl -custom-cflags cxx -debug dist-kernel -dvd -elogind -emacs ffmpeg fortran flac ftp gif git gimp gles2 gmp -gnome -gps gtk gzip -hardened http2 ipv6 java jack jpeg jpeg2k jit io-uring kde latex lm-sensors lto lua lz4 lzip lzma mp4 mp3 mpeg ncurses networkmanager nls pdf png plasma policykit pipewire pulseaudio qt6 -qt5 -ruby screencast sdl systemd tcl tcpd -test threads brotli lz4 ttf tk svg webp avif heif vpx seccomp udisks upower icu unicode verify-sig  uefi usb vaapi vdpau vulkan wayland webp wifi x264 zlib zip zstd xcb dbus libnotify egl"
