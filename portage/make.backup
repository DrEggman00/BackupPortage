#USE="X wayland abi_x86_64 bluetooth input_devices_libinput ipv6 ipv4 -kde -qt6 l10n_pt-BR linguas_pt_BR networkmanager office_implementation_libreoffice pipewire -plasma -qt6 systemd video_cards_intel video_cards_nvidia vulkan -dvd -dvdr -cdr -elogind -openrc gtk -gnome alsa opengl pgo gbm egl gpm jpeg hardened pic"
#USE="X aac acpi alsa asm bluetooth brotli bzip2 cjk curl cxx dbus dist-kernel egl ffmpeg flac fortran ftp gif gimp gles2 gmp gtk gzip heif http2 icu io-uring ipv6 jack java jit jpeg jpeg2k kde latex libnotify lm-sensors lto lua lz4 lzip lzma mp3 mp4 mpeg ncurses networkmanager nls pdf pipewire plasma png policykit pulseaudio qt6 screencast sdl seccomp svg systemd tcl tcpd threads tk ttf udisks uefi unicode upower usb vaapi verify-sig vulkan wayland webp avif wifi x264 xcb zip zlib zstd -Xaw3d -a52 -calendar -cdr -cuda -cups -custom-cflags -debug -dvd -elogind -emacs -gnome -gps -hardened -qt5 -ruby -test -vdpau"


EMERGE_DEFAULT_OPTS="--autounmask-write=y --verbose --ask"
# --jobs=4 --load-average=6"
ACCEPT_LICENSE="*"
ACCEPT_KEYWORDS="amd64"
#MAKEOPTS="-j10 -l9"
MAKEOPTS="-j9 -l8"

NINJAOPTS="${MAKEOPTS}"
LLVM_SLOT="22"
LLVM_TARGETS="X86 NVPTX"

INPUT_DEVICES="libinput"
OFFICE_IMPLEMENTATION="libreoffice"
#VIDEO_CARDS="intel nvidia"


ABI_X86="64"
GRUB_PLATFORMS="efi-64"

VIDEO_CARDS="iris intel nvidia"

FEATURES="buildpkg parallel-fetch parallel-install"
BINPKG_COMPRESS="zstd"
BINPKG_COMPRESS_FLAGS="-19"
PORTAGE_ELOG_SYSTEM="save"

PORTAGE_NICENESS="0"
PORTAGE_IONICE_COMMAND="ionice -c 2 -n 0 -p \${PID}"
# scheduler padrão (normal), não idle
PORTAGE_SCHEDULING_POLICY="other"


LC_MESSAGES=pt_BR.UTF-8


